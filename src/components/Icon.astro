---
type IconName = "car" | "flag" | "film" | "gamepad" | "book" | "terminal";

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 26 } = Astro.props;
---

<svg
  class="block flex-none"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === "car" && (
      <>
        <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2" />
        <circle cx="7" cy="17" r="2" />
        <path d="M9 17h6" />
        <circle cx="17" cy="17" r="2" />
      </>
    )
  }
  {
    name === "flag" && (
      <>
        <path d="M4 22V3" />
        <path d="M4 4h16l-3 3 3 3H4" />
        <path d="M4 7h16" />
        <path d="M8 4v6M12 4v6M16 4v6" />
      </>
    )
  }
  {
    name === "film" && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="1" />
        <path d="M7 4v16M17 4v16" />
        <path d="M3 9h4M3 15h4M17 9h4M17 15h4" />
      </>
    )
  }
  {
    name === "gamepad" && (
      <>
        <line x1="6" x2="10" y1="11" y2="11" />
        <line x1="8" x2="8" y1="9" y2="13" />
        <line x1="15" x2="15.01" y1="12" y2="12" />
        <line x1="18" x2="18.01" y1="10" y2="10" />
        <path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z" />
      </>
    )
  }
  {
    name === "book" && (
      <>
        <path d="M12 6.5C10.5 5 8 4.5 4 5v13c4-.5 6.5 0 8 1.5 1.5-1.5 4-2 8-1.5V5c-4-.5-6.5 0-8 1.5z" />
        <path d="M12 6.5V20" />
      </>
    )
  }
  {
    name === "terminal" && (
      <>
        <polyline points="4 17 10 11 4 5" />
        <line x1="12" x2="20" y1="19" y2="19" />
      </>
    )
  }
</svg>
