---
import { AUTHOR, SOCIALS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="pt-[clamp(2.5rem,5vw,4rem)] pb-[clamp(3rem,6vw,5rem)]">
  <div class="mx-auto w-full max-w-(--maxw) px-(--gutter)">
    <hr class="h-px w-full border-0 bg-line" />
    <div
      class="flex flex-wrap items-start justify-between gap-7 pt-7 max-[720px]:flex-col"
    >
      <div class="flex flex-col gap-[0.35rem]">
        <span
          class="font-display text-2xl leading-none font-semibold tracking-[0.04em] uppercase"
        >
          Balasurya Ganesamoorthi
        </span>
        <span
          class="font-mono text-[0.64rem] tracking-[0.16em] text-muted uppercase"
        >
          {AUTHOR.location}
        </span>
      </div>

      <nav
        class="flex max-w-[26rem] flex-wrap gap-x-[1.2rem] gap-y-[0.4rem]"
        aria-label="Elsewhere"
      >
        {
          SOCIALS.map((s) => (
            <a
              class="font-body text-[0.95rem] font-medium tracking-[0.04em] text-fg-dim uppercase transition-colors duration-200 hover:text-accent-text"
              href={s.href}
              target="_blank"
              rel="me noopener noreferrer"
            >
              {s.label}
            </a>
          ))
        }
        <a
          class="font-body text-[0.95rem] font-medium tracking-[0.04em] text-fg-dim uppercase transition-colors duration-200 hover:text-accent-text"
          href="/rss.xml">RSS</a
        >
      </nav>

      <div
        class="flex flex-col items-end gap-[0.35rem] text-right max-[720px]:items-start max-[720px]:text-left"
      >
        <span
          class="font-mono text-[0.64rem] tracking-[0.16em] text-muted uppercase"
        >
          <span class="text-accent">©</span>
          {year} — Built with Astro
        </span>
        <a
          class="inline-flex items-center gap-2 font-mono text-[0.64rem] tracking-[0.16em] text-fg-dim uppercase transition-colors duration-200 hover:text-accent-text"
          href="#top"
        >
          <span>Back to top</span>
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>
  </div>
</footer>
