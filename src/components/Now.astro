---
import Section from "./Section.astro";
import { NOW, NOW_UPDATED } from "../data/now";
---

<Section id="now" index="06" title="Now" kicker="Currently" align="right">
  <div
    class="reveal mb-[clamp(1.75rem,3vw,2.5rem)] inline-flex items-center gap-[0.6rem] font-mono text-[0.62rem] tracking-[0.16em] text-muted uppercase"
  >
    <span
      class="relative h-2 w-2 flex-none rounded-full bg-accent after:absolute after:inset-[-0.35rem] after:animate-now-pulse after:rounded-full after:border after:border-accent after:content-['']"
      aria-hidden="true"></span>
    <span>Updated {NOW_UPDATED}</span>
  </div>

  <dl class="m-0">
    {
      NOW.map((item, i) => (
        <div
          class="reveal grid grid-cols-[minmax(7rem,0.7fr)_2.5fr] items-baseline gap-[clamp(1rem,3vw,2.5rem)] border-t border-line py-[clamp(1.25rem,2.5vw,1.9rem)] first:border-t-0 first:pt-0 max-[640px]:grid-cols-1 max-[640px]:gap-2"
          style={`--delay:${i * 55}ms`}
        >
          <dt class="font-mono text-[0.62rem] tracking-[0.16em] text-muted uppercase">
            {item.label}
          </dt>
          <dd class="m-0 flex flex-col gap-[0.35rem]">
            <span class="font-display text-[clamp(1.7rem,3.4vw,2.6rem)] leading-[0.9] font-semibold uppercase">
              {item.value}
            </span>
            <span class="max-w-[44ch] text-[1.02em] text-fg-dim">
              {item.detail}
            </span>
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
