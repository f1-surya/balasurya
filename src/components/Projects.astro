---
import Section from "./Section.astro";
import ProjectVisual from "./ProjectVisual.astro";
import { PROJECTS } from "../data/projects";

const tlinkClass =
  "group/link relative inline-flex items-baseline gap-[0.5em] border-b border-line-2 pb-[0.15em] font-body font-medium text-fg transition-colors duration-300 hover:border-accent hover:text-accent-text";
const arrowClass =
  "h-[0.7em] w-[0.7em] transition-transform duration-300 group-hover/link:translate-x-[0.15em] group-hover/link:-translate-y-[0.15em]";
---

<Section
  id="projects"
  index="02"
  title="Projects"
  kicker="Selected work"
  align="right"
  wide
>
  <p class="reveal mb-[clamp(1rem,2vw,1.5rem)] max-w-[46ch] text-fg-dim">
    Things I've built to scratch an itch, learn something properly, or make a
    recurring chore disappear. All of it is public.
  </p>

  <div class="mt-[clamp(0.5rem,2vw,1.5rem)]">
    {
      PROJECTS.map((project, i) => {
        const flip = i % 2 === 1;
        return (
          <article class="project group/project grid grid-cols-[1.05fr_1fr] items-center gap-[clamp(1.75rem,4vw,4rem)] border-t border-line py-[clamp(2.5rem,6vw,4.5rem)] first:border-t-0 first:pt-0 max-[820px]:grid-cols-1 max-[820px]:items-start">
            <div
              class:list={[
                "group/visual reveal relative aspect-[4/3] border border-line transition-colors duration-500 hover:border-line-3 max-[820px]:aspect-[16/10]",
                flip
                  ? "order-2 max-[820px]:order-none"
                  : "max-[820px]:order-none",
              ]}
              style="--rx:0px;--ry:40px"
            >
              <ProjectVisual motif={project.motif} label={project.stack[0]} />
            </div>

            <div
              class:list={[
                flip
                  ? "order-1 max-[820px]:order-none"
                  : "max-[820px]:order-none",
              ]}
            >
              <div class="reveal mb-2 flex items-baseline justify-between gap-4">
                <span class="project-index font-display text-[clamp(2.5rem,5vw,4rem)] leading-[0.8] font-semibold text-transparent">
                  {project.index}
                </span>
                <span class="font-mono text-[0.62rem] tracking-[0.16em] text-muted uppercase">
                  {project.year}
                </span>
              </div>

              <h3
                class="reveal mb-[0.35em] font-display text-[clamp(2.4rem,5.5vw,4.5rem)] leading-[0.82] font-semibold uppercase"
                style="--delay:60ms"
              >
                {project.name}
              </h3>
              <p
                class="reveal mb-[0.9em] font-body text-[clamp(1.2rem,1.9vw,1.5rem)] font-bold tracking-[0.01em] text-accent"
                style="--delay:90ms"
              >
                {project.tagline}
              </p>
              <p
                class="reveal mb-[1.5em] max-w-[48ch] text-fg-dim"
                style="--delay:120ms"
              >
                {project.description}
              </p>

              <ul
                class="reveal mb-7 flex flex-wrap items-center font-mono text-[0.68rem] tracking-[0.1em] text-fg-dim uppercase [&>li+li::before]:px-[0.65em] [&>li+li::before]:text-accent [&>li+li::before]:content-['/']"
                style="--delay:150ms"
              >
                {project.stack.map((tech) => (
                  <li class="flex items-center">{tech}</li>
                ))}
              </ul>

              <div class="reveal flex flex-wrap gap-5" style="--delay:180ms">
                {project.links.map((link) => (
                  <a
                    class={tlinkClass}
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {link.label}
                    <svg
                      class={arrowClass}
                      viewBox="0 0 10 10"
                      aria-hidden="true"
                      fill="none"
                    >
                      <path
                        d="M1 9 9 1M3 1h6v6"
                        stroke="currentColor"
                        stroke-width="1.2"
                      />
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</Section>
